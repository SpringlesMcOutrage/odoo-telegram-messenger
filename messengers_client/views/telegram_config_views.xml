<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_config_form" model="ir.ui.view">
        <field name="name">telegram.config.form</field>
        <field name="model">telegram.config</field>
        <field name="arch" type="xml">
            <form string="Telegram Bot Configuration">
                <header>
                    <button name="test_connection" string="Check Connection"
                            type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Configuration Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="bot_token" password="True"
                                   placeholder="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"/>
                            <field name="webhook_url" placeholder="https://your-domain.com/telegram/webhook"/>
                            <field name="polling_enabled"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="bot_username" readonly="1"/>
                            <field name="bot_name" readonly="1"/>
                            <field name="last_update_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <div class="alert alert-info" role="alert">
                            <h4>How to set up your Telegram Bot:</h4>
                            <ol>
                                <li>Find @BotFather in Telegram</li>
                                <li>Send the /newbot command</li>
                                <li>Give the bot a name and username (must end with 'bot')</li>
                                <li>Copy the token provided by BotFather</li>
                                <li>Paste the token into the "Bot Token" field above</li>
                                <li>Click "Check Connection"</li>
                                <li>Enable "Long Polling" for automatic message polling</li>
                            </ol>
                            <p><strong>Note:</strong> Long Polling automatically checks for new messages every minute.</p>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telegram_config_tree" model="ir.ui.view">
        <field name="name">telegram.config.tree</field>
        <field name="model">telegram.config</field>
        <field name="arch" type="xml">
            <list string="Telegram Configurations">
                <field name="name"/>
                <field name="bot_username"/>
                <field name="bot_name"/>
                <field name="polling_enabled"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_telegram_config" model="ir.actions.act_window">
        <field name="name">Telegram Configuration</field>
        <field name="res_model">telegram.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_telegram_config"
              name="Settings"
              parent="menu_messengers_root"
              action="action_telegram_config"
              sequence="100"/>
</odoo>
