<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_chat_tree" model="ir.ui.view">
        <field name="name">telegram.chat.tree</field>
        <field name="model">telegram.chat</field>
        <field name="arch" type="xml">
            <list string="Telegram Chats">
                <field name="name"/>
                <field name="username"/>
                <field name="chat_id"/>
                <field name="unread_count"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_chat_form" model="ir.ui.view">
        <field name="name">telegram.chat.form</field>
        <field name="model">telegram.chat</field>
        <field name="arch" type="xml">
            <form string="Telegram Chat">
                <header>
                    <button name="mark_as_read" string="Mark as Read" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="avatar" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Contact Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="chat_id"/>
                            <field name="username"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="unread_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids" mode="list">
                                <list>
                                    <field name="date"/>
                                    <field name="sender_name"/>
                                    <field name="content"/>
                                    <field name="is_incoming"/>
                                    <field name="is_read"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_chat" model="ir.actions.act_window">
        <field name="name">Telegram Chats</field>
        <field name="res_model">telegram.chat</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
