msgid "How to set up your Telegram Bot:"
msgstr "Cómo configurar su bot de Telegram:"

msgid "Find @BotFather in Telegram"
msgstr "Busque @BotFather en Telegram"

msgid "Send the /newbot command"
msgstr "Envíe el comando /newbot"

msgid "Give the bot a name and username (must end with 'bot')"
msgstr "Dé al bot un nombre y nombre de usuario (debe terminar en 'bot')"

msgid "Copy the token provided by BotFather"
msgstr "Copie el token proporcionado por BotFather"

msgid "Paste the token into the \"Bot Token\" field above"
msgstr "Pegue el token en el campo \"Bot Token\" de arriba"

msgid "Click \"Check Connection\""
msgstr "Haga clic en \"Verificar conexión\""

msgid "Enable \"Long Polling\" for automatic message polling"
msgstr "Active \"Long Polling\" para el sondeo automático de mensajes"

msgid "Note:"
msgstr "Nota:"

msgid "Long Polling automatically checks for new messages every minute."
msgstr "Long Polling comprueba automáticamente si hay mensajes nuevos cada minuto."

msgid "Telegram Chats"
msgstr "Chats de Telegram"

msgid "Telegram Chat"
msgstr "Chat de Telegram"

msgid "Mark as Read"
msgstr "Marcar como leído"

