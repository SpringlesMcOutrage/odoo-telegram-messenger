msgid "How to set up your Telegram Bot:"
msgstr "So richten Sie Ihren Telegram-Bot ein:"

msgid "Find @BotFather in Telegram"
msgstr "Suchen Sie @BotFather in Telegram"

msgid "Send the /newbot command"
msgstr "Senden Sie den Befehl /newbot"

msgid "Give the bot a name and username (must end with 'bot')"
msgstr "Geben Sie dem Bot einen Namen und Benutzernamen (muss auf 'bot' enden)"

msgid "Copy the token provided by BotFather"
msgstr "Kopieren Sie das von BotFather bereitgestellte Token"

msgid "Paste the token into the \"Bot Token\" field above"
msgstr "Fügen Sie das Token in das Feld \"Bot Token\" oben ein"

msgid "Click \"Check Connection\""
msgstr "Klicken Sie auf \"Verbindung prüfen\""

msgid "Enable \"Long Polling\" for automatic message polling"
msgstr "Aktivieren Sie \"Long Polling\" für automatisches Nachrichten-Polling"

msgid "Note:"
msgstr "Hinweis:"

msgid "Long Polling automatically checks for new messages every minute."
msgstr "Long Polling prüft jede Minute automatisch auf neue Nachrichten."

