<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron для автоматичного отримання повідомлень з Telegram -->
    <record id="ir_cron_telegram_poll_updates" model="ir.cron">
        <field name="name">Telegram: Poll Updates</field>
        <field name="model_id" ref="model_telegram_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_poll_updates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
